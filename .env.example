# Copy to .env and fill in. .env is gitignored and never reaches the repository.

# --- Models ---
OPENAI_API_KEY=sk-...
# Cheap model: extraction, dedupe, routine work
SCOUT_MODEL_FAST=openai:gpt-4.1-mini
# Stronger model: fit analysis, CV writing
SCOUT_MODEL_SMART=openai:gpt-4.1

# --- Search ---
TAVILY_API_KEY=tvly-...

# --- Tracing (optional, but a large help while debugging) ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-sdlc-scout

# --- Memory ---
# Neon Postgres. If unset, the agent runs on an in-memory store: everything is
# lost on restart, but development and testing work.
# Take the connection string from Neon with the ?sslmode=require parameter.
SCOUT_DATABASE_URL=

# --- LinkedIn MCP (burner account, NOT your main profile) ---
# Path to the linkedin-mcp-server binary or launch command.
# Empty means LinkedIn tools are off and the agent runs on the guest source and Tavily.
SCOUT_LINKEDIN_MCP_COMMAND=
# The li_at cookie from the burner account session
LINKEDIN_COOKIE=

# --- User identity ---
# Phase 1 is single-user; namespaces are parameterised regardless.
SCOUT_USER_ID=owner
# Public URL of your MAIN LinkedIn profile, used to build the Candidate Profile
SCOUT_LINKEDIN_PROFILE_URL=
# URL of your personal site
SCOUT_PERSONAL_SITE_URL=
