# Copy to .env and fill in. .env is gitignored and never reaches the repository.

# --- Models ---
OPENAI_API_KEY=sk-...
# Cheap model: extraction, dedupe, routine work. Avoid reasoning models here —
# they bill thinking tokens for a task that is pure structured extraction.
SCOUT_MODEL_FAST=openai:gpt-5.4-nano
# Stronger model: fit analysis, CV writing
SCOUT_MODEL_SMART=openai:gpt-5.4-mini

# --- Search ---
TAVILY_API_KEY=tvly-...

# --- Tracing (optional, but a large help while debugging) ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-sdlc-scout

# --- Memory ---
# Neon Postgres. If unset, the agent runs on an in-memory store: everything is
# lost on restart, but development and testing work.
# Take the connection string from Neon with the ?sslmode=require parameter.
SCOUT_DATABASE_URL=

# --- LinkedIn MCP (burner account, NOT your main profile) ---
# Path to the linkedin-mcp-server binary or launch command. The --no-auto-import
# flag is mandatory: without it the server adopts the LinkedIn session of any
# locally signed-in Chromium browser, which would be your real profile.
# Empty means LinkedIn tools are off and the agent runs on the guest source and Tavily.
SCOUT_LINKEDIN_MCP_COMMAND=
# There is no cookie setting. Since server 4.x the session is a stored browser
# profile under ~/.linkedin-mcp/, created by running `mcp-server-linkedin --login`
# once in a terminal while signed in to the burner account.

# --- HTTP shim (phases 2 and 3) ---
# The key an OpenAI-compatible client presents for full access. Generate with
# `openssl rand -hex 32`. Without it the shim authenticates nobody and answers
# 503 rather than falling open.
SCOUT_OWNER_TOKEN=
SCOUT_HOST=0.0.0.0
SCOUT_PORT=8080

# Guest access is the read-only widget for the personal page (phase 3). Leave it
# false until the endpoint is actually public. The guest token travels inside a
# public web page, so treat it as a gate against casual traffic rather than as a
# secret; the real protections are the missing tools and the request budget in
# config/search.yaml.
SCOUT_GUEST_ENABLED=false
SCOUT_GUEST_TOKEN=

# --- User identity ---
# Phase 1 is single-user; namespaces are parameterised regardless.
SCOUT_USER_ID=owner
# Public URL of your MAIN LinkedIn profile, used to build the Candidate Profile
SCOUT_LINKEDIN_PROFILE_URL=
# URL of your personal site
SCOUT_PERSONAL_SITE_URL=
